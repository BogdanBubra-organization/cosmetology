{
  "name": "gatsby-starter-minimal",
  "private": true,
  "description": "A simple starter to get up and developing quickly with Gatsby",
  "version": "0.1.0",
  "author": "salexpro <dev@salex.pro>",
  "contributors": [
    {
      "name": "Savelii Lukash",
      "email": "SaveliiLukash@gmail.com"
    }
  ],
  "dependencies": {
    "@fontsource/cormorant": "4.5.10",
    "@fontsource/inter": "4.5.15",
    "@formspree/core": "3.0.1",
    "@formspree/react": "2.5.1",
    "@gvrs/gatsby-transformer-blurhash": "2.0.0",
    "@percy/cli": "1.27.3",
    "@reach/router": "^1.3.4",
    "@svgr/webpack": "8.1.0",
    "@tanstack/react-query": "4.36.1",
    "bootstrap": "5.2.3",
    "classnames": "2.3.2",
    "dotenv": "16.3.1",
    "gatsby": "5.12.6",
    "gatsby-plugin-facebook-pixel": "^1.0.8",
    "gatsby-plugin-google-tagmanager": "5.12.1",
    "gatsby-plugin-image": "3.12.1",
    "gatsby-plugin-minify-classnames": "5.0.0",
    "gatsby-plugin-offline": "6.12.1",
    "gatsby-plugin-react-helmet": "6.12.0",
    "gatsby-plugin-sass": "6.12.1",
    "gatsby-plugin-sharp": "5.12.1",
    "gatsby-plugin-svgr-svgo": "2.0.0",
    "gatsby-source-datocms": "5.1.2",
    "gatsby-source-filesystem": "5.12.0",
    "gatsby-transformer-sharp": "5.12.1",
    "gsap": "3.12.2",
    "prop-types": "15.8.1",
    "react": "18.2.0",
    "react-bootstrap": "2.9.0",
    "react-datocms": "4.1.3",
    "react-dom": "18.2.0",
    "react-elfsight-widget": "^1.1.1",
    "react-helmet": "6.1.0",
    "react-hook-form": "^7.51.2",
    "react-input-mask": "3.0.0-alpha.2",
    "sass": "1.69.3",
    "svg-parser": "2.0.4",
    "swiper": "9.4.1"
  },
  "devDependencies": {
    "@commitlint/cli": "18.0.0",
    "@commitlint/config-conventional": "18.0.0",
    "@datocms/cma-client-node": "^5.5.4",
    "datocms-plugin-sdk": "2.2.6",
    "datocms-react-ui": "2.2.6",
    "commitizen": "4.3.0",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "8.52.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "9.0.0",
    "eslint-import-resolver-alias": "1.1.2",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-json": "3.1.0",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-prettier": "5.0.1",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "gatsby-plugin-webpack-bundle-analyser-v2": "1.1.31",
    "husky": "8.0.3",
    "lucide-static": "0.547.0",
    "nano-staged": "0.8.0",
    "prettier": "3.0.3",
    "stylelint": "15.11.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recess-order": "4.3.0",
    "stylelint-config-standard-scss": "11.0.0",
    "stylelint-prettier": "4.0.2",
    "vite": "5.4.21"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "yarn build:icon-picker && gatsby build",
    "develop": "yarn build:icon-picker && gatsby develop -H 0.0.0.0 -o",
    "format": "prettier --ignore-path .gitignore --write \"**/*.{js,jsx,ts,tsx,json,mdx,md,css,scss}\"",
    "start": "yarn develop",
    "serve": "gatsby serve",
    "clean": "gatsby clean",
    "test": "echo \"Write tests! -> https://gatsby.dev/unit-testing\" && exit 1",
    "copy-bs-settings": "node ./scripts/copy-bs-settings.js",
    "build:service-icons": "node ./scripts/service-icons/build-sprite.mjs",
    "build:icon-picker": "yarn build:service-icons && vite build --config ./plugins/dato-icon-picker/vite.config.mjs",
    "develop:icon-picker": "vite --config ./plugins/dato-icon-picker/vite.config.mjs",
    "test:icon-picker": "node ./scripts/service-icons/test-icon-picker.mjs",
    "dato:landing:audit": "node ./scripts/datocms/service-landing-audit.mjs",
    "dato:landing:up": "node ./scripts/datocms/service-landing-up.mjs",
    "dato:landing:finalize": "node ./scripts/datocms/service-landing-finalize.mjs",
    "dato:landing:down": "node ./scripts/datocms/service-landing-down.mjs",
    "prepare": "husky install && yarn copy-bs-settings",
    "cz": "cz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby-starter-default"
  },
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  }
}
